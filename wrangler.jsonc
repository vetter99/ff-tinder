// Cloudflare Worker: serves the built app as static assets and runs worker/index.ts for /api/*
// (the MyFantasyLeague proxy and league trade matches). App routes like /compare fall back to index.html.
{
  "name": "ff-tinder",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist/ff-tinder/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // League trade matches. The table is created by the Worker on first use.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ff-tinder",
    },
  ],
}
